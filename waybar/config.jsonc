{
    "layer": "top",
    "position": "top",
    "margin-top": 3,
    "margin-left":300,
    "margin-right":300,
    "height": 30,
    "modules-left": [
        "cpu",
        "memory",
        "hyprland/workspaces"

    ],
    "modules-center": [
        "clock#date",
        "clock"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/power"
    ],

    // Módulos
    "hyprland/workspaces": {
        "format": "{icon} ",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",   // círculo lleno para activo
            "default": ""   // círculo vacío para el resto
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "clock":{
        "format": " {:%H:%M}", // Formato de hora (ej:  10:34)
        "tooltip-format": "<big>{:%A, %d de %B de %Y}</big>",
        "locale": "es_CL.UTF-8" // Para español
    },

    // --- CAMBIO 3: Este es el NUEVO módulo de fecha ---
    "clock#date": {
        "format": " {:%a, %d %b}", // Formato de fecha (ej:  lun, 10 nov)
        "tooltip-format": "<big>{:%A, %d de %B de %Y}</big>",
        "locale": "es_CL.UTF-8" // Para español
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Conectado",
        "format-disconnected": "󰤭 Desconectado",
        // CAMBIA {name} POR {essid} AQUÍ ABAJO:
        "tooltip-format-wifi": "Red: {essid}\nVelocidad: {bandwidthDownBits}  | {bandwidthUpBits} ",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "networkmanager_dmenu",
        "max-length": 50 
    },

    "custom/monitor": {
        "format": "󰍹 Monitores",  // Icono de Monitor (Nerd Font)
        "on-click": "nwg-displays",
        "tooltip": true,
        "tooltip-format": "Configurar Pantallas"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂯 {device_alias}",
        "format-disconnected": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false, // Desactivamos el tooltip temporalmente para probar
        "on-click": "pavucontrol"
    },
    
    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "tooltip": true,
        "on-click": "kitty -e btop"
    },

    "battery": {
        "states": {
            "good": 90,
            "warning": 30,
            "critical": 14
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "󰍃",
        "on-click": "wlogout",
        "tooltip": "Power Menu"
    }
    

}
